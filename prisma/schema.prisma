// Modelo de datos de la app de finanzas personales.
// Todo lo que pertenece a una persona cuelga de `User` con onDelete: Cascade,
// así borrar la cuenta se lleva sus datos sin dejar huérfanos.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MovementKind {
  gasto
  ingreso
}

enum PaymentMethod {
  efectivo
  debito
  credito
  transferencia
  otro
}

model User {
  id    String @id @default(cuid())
  email String @unique

  /// `sub` de Google: su identificador estable, que no cambia aunque la
  /// persona cambie de email. Es la clave real de la identidad.
  googleId String? @unique
  /// Foto de perfil de Google, para el avatar.
  image    String?
  /// Google confirmó que el email le pertenece. Sin esto no se vincula una
  /// cuenta preexistente, porque alcanzaría para apropiarse de ella.
  emailVerified Boolean @default(false)

  name      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Teléfono en formato E.164 vinculado por WhatsApp. Único: un número
  /// pertenece a una sola cuenta, o cualquiera podría cargar gastos ajenos.
  phone         String?   @unique
  phoneLinkedAt DateTime?

  settings     Settings?
  sessions     Session[]
  categories   Category[]
  transactions Transaction[]
  recurring    RecurringRule[]
  installments InstallmentPlan[]

  codigosWhatsapp  PhoneLinkCode[]
  mensajesWhatsapp WhatsAppMessage[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Settings {
  id     String @id @default(cuid())
  userId String @unique

  /// Sueldo o tope mensual de referencia. 0 = sin barra de avance.
  monthlyBudget Decimal @default(0) @db.Decimal(14, 2)
  currency      String  @default("ARS")
  locale        String  @default("es-AR")
  displayName   String  @default("")

  /// Casa de cambio con la que se muestran los montos en dólares (`blue`,
  /// `oficial`, `bolsa`…). `null` = se muestran en la moneda de la cuenta.
  /// Es solo una forma de mirar: los montos se siguen guardando en pesos.
  usdCasa String?

  /// Apariencia: modo, acento y radio. Guardada como JSON porque es una
  /// preferencia de interfaz, no algo que se consulte ni se filtre.
  /// `null` = nunca se tocó, vale el tema original de la app.
  theme Json?

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("settings")
}

model Category {
  id     String @id @default(cuid())
  userId String

  name  String
  kind  MovementKind
  color String
  icon  String
  /// Las categorías semilla se pueden renombrar pero no borrar.
  system Boolean @default(false)

  createdAt DateTime @default(now())

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  recurring    RecurringRule[]
  installments InstallmentPlan[]

  @@unique([userId, name, kind])
  @@index([userId])
  @@map("categories")
}

model Transaction {
  id     String @id @default(cuid())
  userId String

  kind   MovementKind
  /// Siempre positivo: el signo lo define `kind`. Decimal, no Float:
  /// con plata los errores de punto flotante no son aceptables.
  amount Decimal      @db.Decimal(14, 2)

  categoryId  String
  description String
  /// Fecha local del movimiento, sin hora: es un día del calendario.
  date        DateTime      @db.Date
  method      PaymentMethod @default(efectivo)
  note        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  /// El mensaje de WhatsApp que lo creó, si vino por ahí.
  mensajesWhatsapp WhatsAppMessage[]

  @@index([userId, date])
  @@index([categoryId])
  @@map("transactions")
}

/// Gasto o ingreso que se repite todos los meses. No materializa movimientos:
/// se proyecta al leer cada período (ver lib/finance.ts).
model RecurringRule {
  id     String @id @default(cuid())
  userId String

  kind        MovementKind
  description String
  categoryId  String
  amount      Decimal      @db.Decimal(14, 2)
  /// 1-31; si el mes es más corto se ajusta al último día.
  dayOfMonth  Int
  /// `YYYY-MM` en que arranca.
  startMonth  String
  /// `YYYY-MM` en que termina (inclusive). null = sin fin.
  endMonth    String?
  active      Boolean      @default(true)
  /// Meses `YYYY-MM` salteados puntualmente.
  skipped     String[]     @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([categoryId])
  @@map("recurring_rules")
}

/// Compra en N cuotas. Tampoco se materializa: se proyecta al leer.
model InstallmentPlan {
  id     String @id @default(cuid())
  userId String

  description  String
  categoryId   String
  totalAmount  Decimal       @db.Decimal(14, 2)
  installments Int
  /// `YYYY-MM` de la primera cuota.
  firstMonth   String
  dayOfMonth   Int
  method       PaymentMethod @default(credito)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([categoryId])
  @@map("installment_plans")
}

/// Código de un solo uso para probar que un teléfono es de quien dice serlo.
///
/// Va de la app al WhatsApp, nunca al revés: que alguien escriba un número en
/// un formulario no prueba nada, mandar el código desde ese teléfono sí.
model PhoneLinkCode {
  id        String    @id @default(cuid())
  userId    String
  code      String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("phone_link_codes")
}

/// Bitácora de lo que entró por WhatsApp.
///
/// No guarda el texto del mensaje: para lo que hace falta —no procesar dos
/// veces lo mismo, poder deshacer lo último y limitar cuántos mensajes se
/// atienden por número— alcanza con esto. La app no almacena conversaciones.
model WhatsAppMessage {
  id String @id @default(cuid())

  /// `null` si el número que escribió no está vinculado a ninguna cuenta.
  userId String?

  /// Id del mensaje en WhatsApp. Único: es lo que da idempotencia, porque un
  /// mismo mensaje puede llegar más de una vez.
  waMessageId String @unique

  phone String

  /// Qué se hizo: registrado, deshecho, vinculado, no-entendido, sin-cuenta,
  /// limitado.
  outcome String

  transactionId String?

  createdAt DateTime @default(now())

  user        User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([phone, createdAt])
  @@index([userId, createdAt])
  @@map("whatsapp_messages")
}
