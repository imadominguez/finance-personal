# ---------------------------------------------------------------------------
# Base de datos PostgreSQL
# ---------------------------------------------------------------------------
# En Vercel: Storage -> Create Database -> Postgres (Neon).
# Copiá la variable que te da el panel. Si te ofrece una versión "pooled" y una
# "direct", usá la pooled acá.
DATABASE_URL="postgresql://usuario:password@host:5432/basededatos?sslmode=require"

# ---------------------------------------------------------------------------
# Sesiones
# ---------------------------------------------------------------------------
# Clave con la que se firma la cookie de sesión. Generá una propia con:
#   openssl rand -base64 32
# Si la cambiás, se cierran todas las sesiones abiertas.
SESSION_SECRET="cambiame-por-una-clave-larga-y-aleatoria"
