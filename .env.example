# ---------------------------------------------------------------------------
# Base de datos PostgreSQL
# ---------------------------------------------------------------------------
# En Vercel: Storage -> Create Database -> Postgres (Neon).
# Neon entrega dos URLs y hacen falta las dos:
#
#   DATABASE_URL           la "pooled" (host con -pooler). La usa la app.
#   DATABASE_URL_UNPOOLED  la directa. La usan las migraciones: pgbouncer, en
#                          modo transacción, no soporta lo que hacen.
#
# Si conectás a una Postgres local no hay pooler: poné la misma en las dos, o
# dejá DATABASE_URL_UNPOOLED vacía y el CLI cae a DATABASE_URL.
DATABASE_URL="postgresql://usuario:password@host-pooler.region.aws.neon.tech/basededatos?sslmode=require&channel_binding=require"
DATABASE_URL_UNPOOLED="postgresql://usuario:password@host.region.aws.neon.tech/basededatos?sslmode=require"

# ---------------------------------------------------------------------------
# Sesiones
# ---------------------------------------------------------------------------
# Clave con la que se firma la cookie de sesión. Generá una propia con:
#   openssl rand -base64 32
# Si la cambiás, se cierran todas las sesiones abiertas.
SESSION_SECRET="cambiame-por-una-clave-larga-y-aleatoria"

# ---------------------------------------------------------------------------
# Ingreso con Google
# ---------------------------------------------------------------------------
# Google Cloud Console -> APIs y servicios -> Credenciales -> ID de cliente OAuth
# (tipo "Aplicación web").
#
# En "URI de redireccionamiento autorizados" hay que dar de alta, TAL CUAL, una
# por cada origen donde corra la app:
#   http://localhost:3000/api/auth/google/callback
#   https://tu-dominio.vercel.app/api/auth/google/callback
GOOGLE_CLIENT_ID="xxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="xxxxxxxx"

# ---------------------------------------------------------------------------
# Cargar gastos por WhatsApp (opcional)
# ---------------------------------------------------------------------------
# Sin estas variables el módulo queda apagado: el endpoint responde 503 y la
# tarjeta de Ajustes avisa que no está configurado.
#
# Secreto compartido con el bot. Es lo único que separa a cualquiera de poder
# cargar movimientos en cualquier cuenta, así que tratalo como una contraseña:
#   openssl rand -base64 32
WHATSAPP_BOT_TOKEN=""

# Número del bot en E.164, para armar el enlace de WhatsApp desde Ajustes.
WHATSAPP_NUMERO="+5491100000000"
